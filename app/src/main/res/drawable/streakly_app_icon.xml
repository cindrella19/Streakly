<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- REUSABLE BRAND ICON: Purple Gradient + Fire/Tick Symbol -->
    
    <!-- Layer 1: Background Gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#703FFF"
                android:startColor="#3F6CFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: Brand Symbol (Flame + Success Tick) -->
    <item
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp"
        android:top="20dp">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.75"
                android:scaleY="0.75"
                android:translateY="-5">
                <!-- Flame -->
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M54,25 C54,25 40,40 40,55 C40,65 48,72 54,72 C60,72 68,65 68,55 C68,45 54,25 54,25 Z M54,65 C50,65 46,61 46,55 C46,50 54,40 54,40 C54,40 62,50 62,55 C62,61 58,65 54,65 Z" />
                <!-- Success Tick -->
                <path
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="6"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:pathData="M42,82 L54,92 L78,60" />
            </group>
        </vector>
    </item>
</layer-list>