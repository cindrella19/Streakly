<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F4FF">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Statistics"
        app:titleTextColor="#3F6CFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overall Progress"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#3F6CFF"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/gradient_card_bg"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/totalStreaks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#3F6CFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Habits Tracked"
                    android:textColor="#4F7CFF"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="16dp"/>

                <TextView
                    android:id="@+id/bestStreakEver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Days"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#3F6CFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Streak Ever"
                    android:textColor="#4F7CFF"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/gradient_card_bg"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consistency"
                    android:textStyle="bold"
                    android:textColor="#3F6CFF"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/consistencyProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:indicatorColor="#3F6CFF"
                    app:trackColor="#E6EEFF"
                    app:trackThickness="8dp"
                    app:trackCornerRadius="4dp"
                    android:progress="65"/>

                <TextView
                    android:id="@+id/totalDaysCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="65% completion rate"
                    android:textSize="12sp"
                    android:textColor="#4F7CFF"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>